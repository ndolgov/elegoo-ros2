{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "colcon build",
      "type": "shell",
      "command": "bash",
      "args": [
        "-c",
        "source /opt/ros/jazzy/setup.bash && colcon build --symlink-install"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "panel": "shared",
        "reveal": "always"
      },
      "problemMatcher": "$gcc"
    }
  ]
}
